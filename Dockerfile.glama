# Glama Platform Container for T-Zero PC-Fixer & Codebase Doctor MCP Server
# https://glama.ai/mcp/servers/@toprakahmetaydogmus/tzero-pc-fixer
FROM python:3.12-slim

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    GLAMA_VERSION="1.0.0" \
    PYTHONUNBUFFERED=1

# Install git, ca-certificates, curl, nodejs, npm, and mcp-proxy
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    nodejs \
    npm \
    && npm install -g mcp-proxy@6.9.0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy repository
COPY . /app

# Install package locally
RUN pip install --no-cache-dir .

EXPOSE 3000

# Glama standard transport: mcp-proxy wrapping stdio on port 3000
CMD ["mcp-proxy", "--", "pc-fixer-mcp"]
